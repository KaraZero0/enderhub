# Telegram Bot (required)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
ALLOWED_USER_IDS=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# Host & Tailscale Network Configuration
ENDERHUB_TAILSCALE_IP=100.x.y.z
ENDERHUB_LAN_IP=192.168.1.100
ENDERHUB_LAN_SUBNET=192.168.1.0/24
ENDERHUB_SSH_PORT=2222

# Paths & Optional Integrations
ENDERHUB_HOME=/home/server
NEXTCLOUD_DIR=/mnt/nextcloud
ENDERHUB_SCRIPTS_DIR=/home/server/scripts
ML_PIPELINE_DIR=/home/server/ml-pipeline
SMART_ATTRLOG_GLOB=/var/lib/smartmontools/attrlog.*.csv
